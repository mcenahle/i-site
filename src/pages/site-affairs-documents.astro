---
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="mcenahle 站务文件">
  <Navbar />
  <main>
    <div class="container">
      <h2>mcenahle 站务文件</h2>
      <div class="alert alert-warning alert-dismissable">
        <button
          type="button"
          class="close"
          data-dismiss="alert"
          aria-hidden="true"
        >
          &times;
        </button>
        <Icon name="mdi:clock-start" /> 本页面是一个<b>软重定向</b>页面。<u
          >2026年10月14日前，将移除本页面，并设置真重定向规则。</u
        >
      </div>
      <p>
        本页面已经迁移到：<code
          >mcenahle.<b>dev</b>/site-affairs-documents/</code
        >。
      </p>
      <a
        class="btn btn-default btn-block"
        href="https://mcenahle.dev/site-affairs-documents/"
        target="_blank"
        role="button">点此转到 <Icon name="mdi:open-in-new" /></a
      >
    </div>
  </main>
</Layout>
