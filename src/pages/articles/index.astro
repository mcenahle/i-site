---
import Navbar from "../../components/Navbar.astro";
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

interface BlogModule {
  title: string;
  date: string;
  description: string;
  originalLink: string;
}

const modules = import.meta.glob<BlogModule>("./*.astro", {
  eager: true,
});

const posts = Object.entries(modules)
  // 排除博客首页自己
  .filter(([path]) => path !== "./index.astro")

  // 整理文章信息
  .map(([path, post]) => {
    const filename = path.replace("./", "").replace(".astro", "");

    return {
      title: post.title,
      date: post.date,
      description: post.description,
      url: `/articles/${filename}/`,
    };
  })

  // 按日期从新到旧排列
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Navbar />

<Layout title="Mcenahle 的精选博客文章" description="Mcenahle 的精选博客文章">
  <main class="container">
    <div class="border-bottom">
      <h2 class="text-black">Mcenahle 的精选博客文章</h2>

      <p>
        来自 <a
          href="https://www.blogsclub.org/monthly-picks.html"
          target="_blank"
          >blogsClub 的每月拾光 <Icon name="mdi:open-in-new" /></a
        >
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-muted">暂时还没有文章。</p>
      ) : (
        <div class="list-group">
          {posts.map((post) => (
            <a href={post.url} class="list-group-item">
              <div class="d-flex justify-content-between">
                <div>
                  <div class="fw-bold text-body">{post.title}</div>

                  {post.description && (
                    <div class="small text-muted">{post.description}</div>
                  )}
                </div>

                <time datetime={post.date} class="small text-muted">
                  <Icon name="mdi:calendar-month-outline" /> {post.date}
                </time>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </main>
</Layout>
