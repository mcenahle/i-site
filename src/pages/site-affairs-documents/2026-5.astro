---
import Navbar from "../../components/Navbar.astro";
import SadLayout from "../../layouts/SadLayout.astro";

export const title = "关于博客网站迁移域名、重新启用评论区的公告";
export const no = "mcenahle 站务文件-2026【5】号";
export const date = "2026-05-23";
export const statusTop = "已执行完结。";
export const statusInfo =
  "本公告所描述的内容已经执行完毕，但部分内容可能已经发生变动。";
---

<Navbar />

<SadLayout
  title={title}
  date={date}
  no={no}
  statusTop={statusTop}
  statusInfo={statusInfo}
>
  <div style="text-align:right;">
    <p>{no}</p>
  </div>
  <p>
    为提升博客网站的交流性、沟通性，决定博客网站将迁移域名、重新启用评论区。
  </p>
  <p>具体信息如下：</p>
  <ol>
    <li>
      <p style="text-indent: 0em;">
        博客网站的新域名为：<a
          href="https://blog.mcenahle.page"
          target="_blank"
          rel="noopener noreferrer">https://blog.mcenahle.page</a
        >。该域名自暑假购买 <a
          href="https://mcenahle.page"
          target="_blank"
          rel="noopener noreferrer">mcenahle.page</a
        > 后生效（根据2026【3】号文件。详情请转到 <s
          ><code>https://mcenahle.com/site-affairs-documents/2026-3.html</code
          ></s
        >
        <a
          href="https://hi.mcenahle.page/site-affairs-documents/2026-3.html"
          target="_blank"
          rel="noopener noreferrer"
          >https://hi.mcenahle.page/site-affairs-documents/2026-3.html</a
        >）。因为 mcenahle.page
        的购买日期预计最晚为2026年6月29日，因此博客迁移的最晚日期为2026年7月1日；
      </p>
    </li>
    <li>
      <p style="text-indent: 0em;">
        博客网站恢复评论区，但启用审核机制。即任何评论均将经过审核才能展示。
      </p>
    </li>
  </ol>
  <p>博客迁移后，将向各友情链接、博客组织发送站点迁移的消息。</p><p>
    感谢各位的理解与支持。造成不便，深表歉意。
  </p>

  <div style="text-align:right;">
    <p>Mcenahle</p>
    <p>2026年5月23日</p>
  </div>
</SadLayout>
