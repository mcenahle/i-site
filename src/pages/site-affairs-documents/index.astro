---
import Navbar from "../../components/Navbar.astro";
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

interface BlogModule {
  title: string;
  date: string;
  no: string;
  statusTop: string;
  statusInfo: string;
}

const modules = import.meta.glob<BlogModule>("./*.astro", {
  eager: true,
});

const posts = Object.entries(modules)
  // 排除博客首页自己
  .filter(([path]) => path !== "./index.astro")

  // 整理文章信息
  .map(([path, post]) => {
    const filename = path.replace("./", "").replace(".astro", "");

    return {
      title: post.title,
      date: post.date,
      no: post.no,
      statusTop: post.statusTop,
      statusInfo: post.statusInfo,
      url: `/site-affairs-documents/${filename}/`,
    };
  })

  // 按日期从旧到新排列
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
---

<Navbar />

<Layout title="mcenahle 站务文件" description="mcenahle 站务文件">
  <main class="container">
    <div class="rounded-3">
      <div class="domain-card-header">
        <h2 class="text-black fw-bold">mcenahle 站务文件</h2>
      </div>

      <div class="domain-card-body">
        {
          posts.length === 0 ? (
            <p class="text-muted">暂时还没有文章。</p>
          ) : (
            <div class="list-group list-group-flush">
              {posts.map((post) => (
                <a
                  href={post.url}
                  class="list-group-item list-group-item-action"
                >
                  <div class="d-flex justify-content-between">
                    <div>
                      <div class="fw-bold text-body">{post.title}</div>

                      {post.no && <div class="text-muted">{post.no}</div>}

                      <status datetime={post.date} class="small text-muted">
                        {post.statusTop}
                        {post.statusInfo}
                      </status>
                    </div>

                    <time datetime={post.date} class="small text-muted">
                      <Icon name="mdi:calendar-month-outline" /> {post.date}
                    </time>
                  </div>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </main>
</Layout>
