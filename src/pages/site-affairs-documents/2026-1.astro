---
import Navbar from "../../components/Navbar.astro";
import SadLayout from "../../layouts/SadLayout.astro";

export const title = "关于 mcenahle.cn 网站升级的公告（1）";
export const no = "mcenahle 站务文件-2026【1】号";
export const date = "2026-04-19";
export const statusTop = "已执行完结。";
export const statusInfo =
  "本公告所描述的内容已经执行完毕，但部分内容可能已经发生变动。";
---

<Navbar />

<SadLayout
  title={title}
  date={date}
  no={no}
  statusTop={statusTop}
  statusInfo={statusInfo}
>
  <div style="text-align:right;">
    <p>{no}</p>
  </div>
  <p style="text-indent: 0em;">各位访客您好：</p>
  <p>
    为了进一步提升访问速度与整体体验，本站近期将进行一次架构升级与部署调整。
  </p>
  <p>
    本次升级主要包括：采用全新的静态化部署架构（SSG），优化页面加载性能；与此同时，同步进行调整服务器与分发方式，提高访问稳定性。
  </p>
  <p>在升级期间：</p>
  <ul>
    <li>
      现有网站 <a
        href="https://mcenahle.cn"
        target="_blank"
        rel="noopener noreferrer">https://mcenahle.cn</a
      > 将继续正常运行；
    </li>
    <li>
      新版本网站将先部署至测试地址。待新站点稳定后，将切换至正式域名（<a
        href="https://mcenahle.cn"
        target="_blank"
        rel="noopener noreferrer">https://mcenahle.cn</a
      >）。
    </li>
  </ul>
  <p>预期升级完成日期：2026年4月24日前。</p>
  <p>感谢你的理解与支持。</p>
  <div style="text-align:right;">
    <p>Mcenahle</p>
    <p>2026年4月19日</p>
  </div>
</SadLayout>
