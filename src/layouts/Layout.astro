---
import "../styles/global.scss";
import { Icon } from "astro-icon/components";
import "sweetalert2/themes/material-ui.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "i.mcenahle.page", description = "" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/css/bootstrap.min.css"
    />
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.1/jquery.min.js"
    ></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/js/bootstrap.min.js"
    ></script>

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body id="top" data-pagefind-body>
    <div class="alert alert-info" id="infos">
      <Icon name="mdi:verified" /> 本网站为 Mcenahle 主页网站。目前正在开发中。<a
        href="#"
        data-toggle="modal"
        data-target="#infosModal"
        ><Icon name="mdi:information-slab-circle-outline" />
        &nbsp;<u>了解更多信息</u></a
      >
    </div>
    <slot />
    <button id="backTop" class="btn btn-primary"
      ><Icon name="mdi:arrow-top" style="height:28px; width:20px" />
    </button>
    <footer data-pagefind-ignore>
      <hr />
      <p style="text-align: center;">
        <img
          src="/not-by-ai-resources/Photographed By Human/_SVG/Photographed-By-Human-Not-By-AI-Badge-white.svg"
          alt="Photographed By Human Badge"
          width="80"
          style="margin-right: 12px;"
        />
        <img
          src="/not-by-ai-resources/Written By Human/_SVG/Written-By-Human-Not-By-AI-Badge-white.svg"
          alt="Written By Human Badge"
          width="80"
          style="margin-right: 12px;"
        />
        <button id="delete-btn" class="btn btn-default btn-xs"
          ><Icon name="mdi:picture" /> 背景图片拍摄地</button
        >
      </p>
      <p style="text-align: center;">
        © 2026 i.mcenahle.page. <a
          href="https://mn.edu.kg/gh/i-site/"
          target="_blank"><Icon name="mdi:github" /> 网站源代码</a
        >
      </p>
      <br />
    </footer>
  </body>

  <div
    class="modal fade"
    id="infosModal"
    tabindex="-1"
    role="dialog"
    aria-labelledby="infosModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-hidden="true">&times;</button
          >
          <h4 class="modal-title" id="infosModalLabel">
            本网站为 Mcenahle 主页网站（正在开发中）。
          </h4>
        </div>
        <div class="modal-body">
          <p>
            <Icon name="mdi:web" /> 官方网站使用 mcenahle.page 或者其它域名，例如
            mcenahle.dev。
          </p>
          <p><Icon name="mdi:https" /> 安全网站使用 HTTPS。</p>
          <p><Icon name="mdi:github" /> 源代码可在 GitHub 上获取。</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal"
            >关闭</button
          >
        </div>
      </div><!-- /.modal-content -->
    </div><!-- /.modal -->
  </div>

  <script>
    const backTop = document.getElementById("backTop");

    window.addEventListener("scroll", () => {
      if (window.scrollY > 300) {
        backTop.classList.add("show");
      } else {
        backTop.classList.remove("show");
      }
    });

    backTop.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    });
  </script>

  <script>
    import Swal from "sweetalert2";

    const btn = document.querySelector("#delete-btn");

    btn?.addEventListener("click", () => {
      Swal.fire({
        title: "背景图片拍摄地",
        theme: "material-ui",
        text: "上海市崇明区城桥镇南门长江大堤。",
        icon: "info",
        showCancelButton: false,
        confirmButtonText: "确定",
      });
    });
  </script>
</html>
