---
import "../styles/global.scss";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";

import { ClientRouter } from "astro:transitions";

import "sweetalert2/themes/material-ui.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "hi.mcenahle.page", description = "" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <link rel="me" href="https://social.vivaldi.net/@mcenahle" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/css/bootstrap.min.css"
    />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/js/bootstrap.min.js"></script>

    <meta name="generator" content={Astro.generator} />

    <ClientRouter />
    <title>{title}</title>
  </head>
  <body id="top" data-pagefind-body>
    <div class="v6-tease">
      <Icon name="mdi:verified" /> <b>本网站为 Mcenahle 主页网站。</b>
      处于现代化考虑，网站即将从 Bootstrap 3 升级到 6，目前正在等待{" "}
      <a
        href="https://github.com/twbs/bootstrap/releases"
        rel="noopener"
        target="_blank"
      >
        <u>Bootstrap 6 的发布情况</u> <Icon name="mdi:open-in-new" />
      </a>
      。6 发布后，将进行更新。
      <a href="https://hi.mcenahle.dev" rel="noopener" target="_blank">
        <u>查看开发中、正在逐步迁移的新个人主页网站</u>{" "}
        <Icon name="mdi:open-in-new" />
      </a>
    </div>
    <slot />
    <button id="backTop" class="btn btn-primary">
      <Icon name="mdi:arrow-top" style="height:28px; width:20px" />
    </button>
    <Footer />
  </body>
  <div
    class="modal fade"
    id="infosModal"
    tabindex="-1"
    role="dialog"
    aria-labelledby="infosModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-hidden="true"
          >
            &times;
          </button>
          <h4 class="modal-title" id="infosModalLabel">
            本网站为 Mcenahle 主页网站。
          </h4>
        </div>
        <div class="modal-body">
          <p>
            <Icon name="mdi:web" /> 官方网站使用 mcenahle.page
            或者其它域名，例如 mcenahle.dev。
          </p>
          <p>
            <Icon name="mdi:https" /> 安全网站使用 HTTPS。
          </p>
          <p>
            <Icon name="mdi:github" /> 源代码可在 GitHub 上获取。
          </p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">
            关闭
          </button>
        </div>
      </div>
      <!-- /.modal-content -->
    </div>
    <!-- /.modal -->
  </div>

  <script>
    const backTop = document.getElementById("backTop");

    window.addEventListener("scroll", () => {
      if (window.scrollY > 300) {
        backTop.classList.add("show");
      } else {
        backTop.classList.remove("show");
      }
    });

    backTop.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    });
  </script>
  <style>
    .v6-tease {
      display: block;
      padding: 10px 14px;
      color: #fff;
      text-align: center;
      background: linear-gradient(90deg, rgb(168, 131, 21), rgb(49, 135, 255));
      a {
        color: white;
      }
    }
  </style>
</html>
