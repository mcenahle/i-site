---
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  date: string;
  no: string;
  statusTop: string;
  statusInfo: string;
}

const { title, date, no, statusTop, statusInfo = "" } = Astro.props;
---

<Layout title={title}>
  <meta charset="utf-8" />
  <main class="container">
    <ul class="breadcrumb">
      <li><a href="/">i.mcenahle.page</a></li>
      <li><a href="/site-affairs-documents/">站务文件</a></li>
      <li class="active">{title}</li>
    </ul>
    <div class="panel panel-default">
      <div class="page-heading" style="padding:15px">
        <h2>
          {title}
        </h2>
        <h5 style="text-align: center;">
          <Icon name="mdi:calendar-month-outline" /> 发布日期：{date}
        </h5>
      </div>
      <div class="panel-body">
        <div class="article" id="sad-article">
          <slot />
        </div>
        <hr style="margin-top: 24px;" />
        <a class="btn btn-primary" href="/site-affairs-documents/" role="button"
          ><Icon name="mdi:arrow-left" /> 返回</a
        >
        <button
          class="btn btn-info"
          data-toggle="modal"
          data-target="#statusModal"
          style="margin-left: 12px;"
          ><Icon name="mdi:timer-outline" /> 查看目前执行状态</button
        >
      </div>
    </div>
  </main>

  <div
    class="modal fade"
    id="statusModal"
    tabindex="-1"
    role="dialog"
    aria-labelledby="statusModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-hidden="true">&times;</button
          >
          <h4 class="modal-title" id="statusModalLabel">
            {title} - {no} 目前执行状态
          </h4>
        </div>
        <div class="modal-body">
          <div class="alert alert-info">
            <p><b>{statusTop}</b></p>
            <p>{statusInfo}</p>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal"
            >关闭</button
          >
        </div>
      </div>
    </div>
  </div>
</Layout>
