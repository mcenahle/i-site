---
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  date: string;
  description: string;
  originalLink: string;
}

const { title, date, description, originalLink = "" } = Astro.props;
---

<Layout title={title} description={description}>
  <main class="container">
    <ul class="breadcrumb">
      <li><a href="/">i.mcenahle.page</a></li>
      <li><a href="/articles">精选博客文章</a></li>
      <li class="active">{title}</li>
    </ul>
    <div class="panel panel-default">
      <div class="page-heading" style="padding:15px">
        <h2>
          {title}
          <small style="margin-left: 12px;">{date}</small>
        </h2>
      </div>
      <div class="panel-body">
        <div class="alert alert-info">
          <p><b>文章阅读引言</b></p>
          <p>{description}</p>
        </div>
        <div class="article">
          <slot />
        </div>
        <hr style="margin-top: 24px;" />
        <a class="btn btn-primary" href="/articles" role="button"
          ><Icon name="mdi:arrow-left" /> 返回</a
        >
        <a
          href={originalLink}
          class="btn btn-default"
          role="button"
          style="margin-left: 12px;"
          >查看原始博客文章 <Icon name="mdi:open-in-new" /></a
        >
      </div>
    </div>
  </main>
</Layout>
